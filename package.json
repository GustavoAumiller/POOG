{
	"name": "babylonjs-editor-nextjs-template",
	"version": "0.1.0",
	"private": true,
	"main": "electron.js",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"generate": "babylonjs-editor-cli pack",
		"start": "next start",
		"lint": "next lint",
		"electron": "electron .",
		"electron:build": "npm run build && electron-builder"
	},
	"build": {
		"appId": "com.POOG.app",
		"productName": "POOG",
		"compression": "maximum",
		"files": [
			"electron.js",
			".next/**/*",
			"public/**/*",
			"package.json"
		],
		"win": {
			"target": "nsis",
			"icon": "public/icon.ico"
		},
		"linux": {
			"target": "AppImage",
			"category": "Game"
		},
		"directories": {
			"output": "dist"
		}
	},
	"dependencies": {
		"@babylonjs/addons": "9.12.1",
		"@babylonjs/core": "9.12.1",
		"@babylonjs/gui": "9.12.1",
		"@babylonjs/havok": "1.3.12",
		"@babylonjs/materials": "9.12.1",
		"@recast-navigation/core": "^0.43.1",
		"@recast-navigation/generators": "^0.43.1",
		"@recast-navigation/wasm": "^0.43.1",
		"babylonjs-editor-tools": "^5.5.2",
		"next": "^16.2.10",
		"react": "18.2.0",
		"react-dom": "18.2.0"
	},
	"devDependencies": {
		"@types/node": "^22",
		"@types/react": "^18",
		"@types/react-dom": "^18",
		"autoprefixer": "^10.0.1",
		"babylonjs-editor-cli": "^5.5.2",
		"electron": "^43.0.0",
		"electron-builder": "^26.15.3",
		"eslint": "9.29.0",
		"eslint-config-next": "16.2.6",
		"postcss": "^8",
		"raw-loader": "^4.0.2",
		"tailwindcss": "3.4.4",
		"typescript": "5.9.3"
	}
}
